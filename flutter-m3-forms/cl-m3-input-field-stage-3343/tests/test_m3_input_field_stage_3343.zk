fn test_run():
    let inp = create_m3_input_3343("Enter username")
    if inp.max_length != 33: sys_exit(1)
    if not m3_input_validate_len_3343(10, inp.max_length): sys_exit(1)
    if m3_input_validate_len_3343(1000, inp.max_length): sys_exit(1)

fn main():
