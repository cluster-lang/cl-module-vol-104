import "../m3i_2740.zk"

fn test_run():
    let inp = create_m3_input_2740("Enter username")
    if inp.max_length != 30: sys_exit(1)
    if not m3_input_validate_len_2740(10, inp.max_length): sys_exit(1)
    if m3_input_validate_len_2740(1000, inp.max_length): sys_exit(1)

fn main():
