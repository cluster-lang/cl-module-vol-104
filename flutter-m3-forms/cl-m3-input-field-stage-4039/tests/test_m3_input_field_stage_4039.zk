// cl-m3-input-field-stage-4039: Test Suite
import "../m3i_4039.zk"

fn test_run():
    let inp = create_m3_input_4039("Enter username")
    if inp.max_length != 49: sys_exit(1)
    if not m3_input_validate_len_4039(10, inp.max_length): sys_exit(1)
    if m3_input_validate_len_4039(1000, inp.max_length): sys_exit(1)

fn main():
    test_run()
    print("✓ All tests passed for cl-m3-input-field-stage-4039!")
