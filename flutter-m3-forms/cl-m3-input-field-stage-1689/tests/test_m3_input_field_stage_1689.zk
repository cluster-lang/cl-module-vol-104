// cl-m3-input-field-stage-1689: Test Suite
import "../m3i_1689.zk"

fn test_run():
    let inp = create_m3_input_1689("Enter username")
    if inp.max_length != 39: sys_exit(1)
    if not m3_input_validate_len_1689(10, inp.max_length): sys_exit(1)
    if m3_input_validate_len_1689(1000, inp.max_length): sys_exit(1)

fn main():
    test_run()
    print("✓ All tests passed for cl-m3-input-field-stage-1689!")
