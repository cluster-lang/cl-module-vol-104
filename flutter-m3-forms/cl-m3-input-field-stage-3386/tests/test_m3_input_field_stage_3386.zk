import "../m3i_3386.zk"

fn test_run():
    let inp = create_m3_input_3386("Enter username")
    if inp.max_length != 36: sys_exit(1)
    if not m3_input_validate_len_3386(10, inp.max_length): sys_exit(1)
    if m3_input_validate_len_3386(1000, inp.max_length): sys_exit(1)

fn main():
