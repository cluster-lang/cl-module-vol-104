import "../m3i_2170.zk"

fn test_run():
    let inp = create_m3_input_2170("Enter username")
    if inp.max_length != 40: sys_exit(1)
    if not m3_input_validate_len_2170(10, inp.max_length): sys_exit(1)
    if m3_input_validate_len_2170(1000, inp.max_length): sys_exit(1)

fn main():
