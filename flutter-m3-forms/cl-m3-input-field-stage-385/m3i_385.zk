model M3InputSpec:
    placeholder: string
    max_length: int
    is_error: bool

fn create_m3_input_385(placeholder: string) -> M3InputSpec:
    return M3InputSpec(placeholder, 35, false)

fn m3_input_validate_len_385(text_len: int, max_len: int) -> bool:
    return text_len <= max_len
