// cl-m3-input-field-stage-107: Test Suite
import "../m3i_107.zk"

fn test_run():
    let inp = create_m3_input_107("Enter username")
    if inp.max_length != 37: sys_exit(1)
    if not m3_input_validate_len_107(10, inp.max_length): sys_exit(1)
    if m3_input_validate_len_107(1000, inp.max_length): sys_exit(1)

fn main():
    test_run()
    print("✓ All tests passed for cl-m3-input-field-stage-107!")
