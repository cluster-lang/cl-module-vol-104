fn test_run():
    let inp = create_m3_input_2434("Enter username")
    if inp.max_length != 44: sys_exit(1)
    if not m3_input_validate_len_2434(10, inp.max_length): sys_exit(1)
    if m3_input_validate_len_2434(1000, inp.max_length): sys_exit(1)

fn main():
