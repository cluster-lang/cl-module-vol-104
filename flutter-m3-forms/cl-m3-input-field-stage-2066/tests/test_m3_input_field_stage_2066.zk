// cl-m3-input-field-stage-2066: Test Suite
import "../m3i_2066.zk"

fn test_run():
    let inp = create_m3_input_2066("Enter username")
    if inp.max_length != 36: sys_exit(1)
    if not m3_input_validate_len_2066(10, inp.max_length): sys_exit(1)
    if m3_input_validate_len_2066(1000, inp.max_length): sys_exit(1)

fn main():
    test_run()
    print("✓ All tests passed for cl-m3-input-field-stage-2066!")
