import "../m3i_3260.zk"

fn test_run():
    let inp = create_m3_input_3260("Enter username")
    if inp.max_length != 30: sys_exit(1)
    if not m3_input_validate_len_3260(10, inp.max_length): sys_exit(1)
    if m3_input_validate_len_3260(1000, inp.max_length): sys_exit(1)

fn main():
