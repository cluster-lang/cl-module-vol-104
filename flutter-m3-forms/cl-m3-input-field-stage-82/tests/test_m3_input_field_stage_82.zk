// cl-m3-input-field-stage-82: Test Suite
import "../m3i_82.zk"

fn test_run():
    let inp = create_m3_input_82("Enter username")
    if inp.max_length != 32: sys_exit(1)
    if not m3_input_validate_len_82(10, inp.max_length): sys_exit(1)
    if m3_input_validate_len_82(1000, inp.max_length): sys_exit(1)

fn main():
    test_run()
    print("✓ All tests passed for cl-m3-input-field-stage-82!")
