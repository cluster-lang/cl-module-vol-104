fn test_run():
    let inp = create_m3_input_1126("Enter username")
    if inp.max_length != 36: sys_exit(1)
    if not m3_input_validate_len_1126(10, inp.max_length): sys_exit(1)
    if m3_input_validate_len_1126(1000, inp.max_length): sys_exit(1)

fn main():
