import "../m3i_4211.zk"

fn test_run():
    let inp = create_m3_input_4211("Enter username")
    if inp.max_length != 41: sys_exit(1)
    if not m3_input_validate_len_4211(10, inp.max_length): sys_exit(1)
    if m3_input_validate_len_4211(1000, inp.max_length): sys_exit(1)

fn main():
