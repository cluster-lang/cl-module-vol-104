fn test_run():
    let inp = create_m3_input_1125("Enter username")
    if inp.max_length != 35: sys_exit(1)
    if not m3_input_validate_len_1125(10, inp.max_length): sys_exit(1)
    if m3_input_validate_len_1125(1000, inp.max_length): sys_exit(1)

fn main():
