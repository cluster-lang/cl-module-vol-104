import "../m3i_3542.zk"

fn test_run():
    let inp = create_m3_input_3542("Enter username")
    if inp.max_length != 32: sys_exit(1)
    if not m3_input_validate_len_3542(10, inp.max_length): sys_exit(1)
    if m3_input_validate_len_3542(1000, inp.max_length): sys_exit(1)

fn main():
