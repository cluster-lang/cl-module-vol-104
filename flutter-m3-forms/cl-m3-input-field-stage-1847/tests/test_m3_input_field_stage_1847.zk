import "../m3i_1847.zk"

fn test_run():
    let inp = create_m3_input_1847("Enter username")
    if inp.max_length != 37: sys_exit(1)
    if not m3_input_validate_len_1847(10, inp.max_length): sys_exit(1)
    if m3_input_validate_len_1847(1000, inp.max_length): sys_exit(1)

fn main():
