model M3InputSpec:
    placeholder: string
    max_length: int
    is_error: bool

fn create_m3_input_738(placeholder: string) -> M3InputSpec:
    return M3InputSpec(placeholder, 48, false)

fn m3_input_validate_len_738(text_len: int, max_len: int) -> bool:
    return text_len <= max_len
