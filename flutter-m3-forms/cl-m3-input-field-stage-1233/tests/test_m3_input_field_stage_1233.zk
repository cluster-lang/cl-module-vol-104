fn test_run():
    let inp = create_m3_input_1233("Enter username")
    if inp.max_length != 43: sys_exit(1)
    if not m3_input_validate_len_1233(10, inp.max_length): sys_exit(1)
    if m3_input_validate_len_1233(1000, inp.max_length): sys_exit(1)

fn main():
