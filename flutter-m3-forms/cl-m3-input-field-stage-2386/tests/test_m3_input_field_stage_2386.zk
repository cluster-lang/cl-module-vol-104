import "../m3i_2386.zk"

fn test_run():
    let inp = create_m3_input_2386("Enter username")
    if inp.max_length != 36: sys_exit(1)
    if not m3_input_validate_len_2386(10, inp.max_length): sys_exit(1)
    if m3_input_validate_len_2386(1000, inp.max_length): sys_exit(1)

fn main():
