// cl-m3-input-field-stage-857: Test Suite
import "../m3i_857.zk"

fn test_run():
    let inp = create_m3_input_857("Enter username")
    if inp.max_length != 47: sys_exit(1)
    if not m3_input_validate_len_857(10, inp.max_length): sys_exit(1)
    if m3_input_validate_len_857(1000, inp.max_length): sys_exit(1)

fn main():
    test_run()
    print("✓ All tests passed for cl-m3-input-field-stage-857!")
