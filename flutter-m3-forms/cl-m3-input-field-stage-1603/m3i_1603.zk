model M3InputSpec:
    placeholder: string
    max_length: int
    is_error: bool

fn create_m3_input_1603(placeholder: string) -> M3InputSpec:
    return M3InputSpec(placeholder, 33, false)

fn m3_input_validate_len_1603(text_len: int, max_len: int) -> bool:
    return text_len <= max_len
