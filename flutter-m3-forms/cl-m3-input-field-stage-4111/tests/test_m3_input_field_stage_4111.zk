fn test_run():
    let inp = create_m3_input_4111("Enter username")
    if inp.max_length != 41: sys_exit(1)
    if not m3_input_validate_len_4111(10, inp.max_length): sys_exit(1)
    if m3_input_validate_len_4111(1000, inp.max_length): sys_exit(1)

fn main():
