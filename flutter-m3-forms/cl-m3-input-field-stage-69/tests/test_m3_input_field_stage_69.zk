import "../m3i_69.zk"

fn test_run():
    let inp = create_m3_input_69("Enter username")
    if inp.max_length != 39: sys_exit(1)
    if not m3_input_validate_len_69(10, inp.max_length): sys_exit(1)
    if m3_input_validate_len_69(1000, inp.max_length): sys_exit(1)

fn main():
