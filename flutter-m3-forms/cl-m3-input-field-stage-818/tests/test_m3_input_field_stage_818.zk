fn test_run():
    let inp = create_m3_input_818("Enter username")
    if inp.max_length != 48: sys_exit(1)
    if not m3_input_validate_len_818(10, inp.max_length): sys_exit(1)
    if m3_input_validate_len_818(1000, inp.max_length): sys_exit(1)

fn main():
