import "../m3i_4010.zk"

fn test_run():
    let inp = create_m3_input_4010("Enter username")
    if inp.max_length != 40: sys_exit(1)
    if not m3_input_validate_len_4010(10, inp.max_length): sys_exit(1)
    if m3_input_validate_len_4010(1000, inp.max_length): sys_exit(1)

fn main():
