// cl-m3-input-field-stage-240: Test Suite
import "../m3i_240.zk"

fn test_run():
    let inp = create_m3_input_240("Enter username")
    if inp.max_length != 30: sys_exit(1)
    if not m3_input_validate_len_240(10, inp.max_length): sys_exit(1)
    if m3_input_validate_len_240(1000, inp.max_length): sys_exit(1)

fn main():
    test_run()
    print("✓ All tests passed for cl-m3-input-field-stage-240!")
