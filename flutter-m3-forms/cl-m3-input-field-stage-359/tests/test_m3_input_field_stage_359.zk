import "../m3i_359.zk"

fn test_run():
    let inp = create_m3_input_359("Enter username")
    if inp.max_length != 49: sys_exit(1)
    if not m3_input_validate_len_359(10, inp.max_length): sys_exit(1)
    if m3_input_validate_len_359(1000, inp.max_length): sys_exit(1)

fn main():
