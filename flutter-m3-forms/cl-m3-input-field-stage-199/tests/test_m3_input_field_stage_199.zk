// cl-m3-input-field-stage-199: Test Suite
import "../m3i_199.zk"

fn test_run():
    let inp = create_m3_input_199("Enter username")
    if inp.max_length != 49: sys_exit(1)
    if not m3_input_validate_len_199(10, inp.max_length): sys_exit(1)
    if m3_input_validate_len_199(1000, inp.max_length): sys_exit(1)

fn main():
    test_run()
    print("✓ All tests passed for cl-m3-input-field-stage-199!")
