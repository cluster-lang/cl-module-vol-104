import "../m3i_4445.zk"

fn test_run():
    let inp = create_m3_input_4445("Enter username")
    if inp.max_length != 35: sys_exit(1)
    if not m3_input_validate_len_4445(10, inp.max_length): sys_exit(1)
    if m3_input_validate_len_4445(1000, inp.max_length): sys_exit(1)

fn main():
