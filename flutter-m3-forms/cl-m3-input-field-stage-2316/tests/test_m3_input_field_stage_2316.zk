import "../m3i_2316.zk"

fn test_run():
    let inp = create_m3_input_2316("Enter username")
    if inp.max_length != 46: sys_exit(1)
    if not m3_input_validate_len_2316(10, inp.max_length): sys_exit(1)
    if m3_input_validate_len_2316(1000, inp.max_length): sys_exit(1)

fn main():
