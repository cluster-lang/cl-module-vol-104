// cl-m3-input-field-stage-516: Test Suite
import "../m3i_516.zk"

fn test_run():
    let inp = create_m3_input_516("Enter username")
    if inp.max_length != 46: sys_exit(1)
    if not m3_input_validate_len_516(10, inp.max_length): sys_exit(1)
    if m3_input_validate_len_516(1000, inp.max_length): sys_exit(1)

fn main():
    test_run()
    print("✓ All tests passed for cl-m3-input-field-stage-516!")
