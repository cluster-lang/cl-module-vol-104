import "../m3i_3534.zk"

fn test_run():
    let inp = create_m3_input_3534("Enter username")
    if inp.max_length != 44: sys_exit(1)
    if not m3_input_validate_len_3534(10, inp.max_length): sys_exit(1)
    if m3_input_validate_len_3534(1000, inp.max_length): sys_exit(1)

fn main():
