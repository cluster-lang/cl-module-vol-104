import "../m3i_3442.zk"

fn test_run():
    let inp = create_m3_input_3442("Enter username")
    if inp.max_length != 32: sys_exit(1)
    if not m3_input_validate_len_3442(10, inp.max_length): sys_exit(1)
    if m3_input_validate_len_3442(1000, inp.max_length): sys_exit(1)

fn main():
