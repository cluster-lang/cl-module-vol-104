import "../m3i_316.zk"

fn test_run():
    let inp = create_m3_input_316("Enter username")
    if inp.max_length != 46: sys_exit(1)
    if not m3_input_validate_len_316(10, inp.max_length): sys_exit(1)
    if m3_input_validate_len_316(1000, inp.max_length): sys_exit(1)

fn main():
