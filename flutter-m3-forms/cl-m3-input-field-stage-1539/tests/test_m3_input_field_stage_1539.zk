import "../m3i_1539.zk"

fn test_run():
    let inp = create_m3_input_1539("Enter username")
    if inp.max_length != 49: sys_exit(1)
    if not m3_input_validate_len_1539(10, inp.max_length): sys_exit(1)
    if m3_input_validate_len_1539(1000, inp.max_length): sys_exit(1)

fn main():
