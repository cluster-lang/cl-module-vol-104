import "../m3i_4690.zk"

fn test_run():
    let inp = create_m3_input_4690("Enter username")
    if inp.max_length != 40: sys_exit(1)
    if not m3_input_validate_len_4690(10, inp.max_length): sys_exit(1)
    if m3_input_validate_len_4690(1000, inp.max_length): sys_exit(1)

fn main():
