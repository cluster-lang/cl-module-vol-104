import "../m3i_652.zk"

fn test_run():
    let inp = create_m3_input_652("Enter username")
    if inp.max_length != 42: sys_exit(1)
    if not m3_input_validate_len_652(10, inp.max_length): sys_exit(1)
    if m3_input_validate_len_652(1000, inp.max_length): sys_exit(1)

fn main():
