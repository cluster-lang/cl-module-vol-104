import "../m3i_2825.zk"

fn test_run():
    let inp = create_m3_input_2825("Enter username")
    if inp.max_length != 35: sys_exit(1)
    if not m3_input_validate_len_2825(10, inp.max_length): sys_exit(1)
    if m3_input_validate_len_2825(1000, inp.max_length): sys_exit(1)

fn main():
