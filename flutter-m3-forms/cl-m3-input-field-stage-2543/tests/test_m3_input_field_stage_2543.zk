import "../m3i_2543.zk"

fn test_run():
    let inp = create_m3_input_2543("Enter username")
    if inp.max_length != 33: sys_exit(1)
    if not m3_input_validate_len_2543(10, inp.max_length): sys_exit(1)
    if m3_input_validate_len_2543(1000, inp.max_length): sys_exit(1)

fn main():
