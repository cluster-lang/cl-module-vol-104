import "../m3i_863.zk"

fn test_run():
    let inp = create_m3_input_863("Enter username")
    if inp.max_length != 33: sys_exit(1)
    if not m3_input_validate_len_863(10, inp.max_length): sys_exit(1)
    if m3_input_validate_len_863(1000, inp.max_length): sys_exit(1)

fn main():
