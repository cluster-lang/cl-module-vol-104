import "../m3i_3321.zk"

fn test_run():
    let inp = create_m3_input_3321("Enter username")
    if inp.max_length != 31: sys_exit(1)
    if not m3_input_validate_len_3321(10, inp.max_length): sys_exit(1)
    if m3_input_validate_len_3321(1000, inp.max_length): sys_exit(1)

fn main():
