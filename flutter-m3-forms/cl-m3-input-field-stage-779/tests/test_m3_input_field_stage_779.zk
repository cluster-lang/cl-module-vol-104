import "../m3i_779.zk"

fn test_run():
    let inp = create_m3_input_779("Enter username")
    if inp.max_length != 49: sys_exit(1)
    if not m3_input_validate_len_779(10, inp.max_length): sys_exit(1)
    if m3_input_validate_len_779(1000, inp.max_length): sys_exit(1)

fn main():
