import "../m3i_3161.zk"

fn test_run():
    let inp = create_m3_input_3161("Enter username")
    if inp.max_length != 31: sys_exit(1)
    if not m3_input_validate_len_3161(10, inp.max_length): sys_exit(1)
    if m3_input_validate_len_3161(1000, inp.max_length): sys_exit(1)

fn main():
