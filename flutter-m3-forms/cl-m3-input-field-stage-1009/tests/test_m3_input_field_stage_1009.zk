import "../m3i_1009.zk"

fn test_run():
    let inp = create_m3_input_1009("Enter username")
    if inp.max_length != 39: sys_exit(1)
    if not m3_input_validate_len_1009(10, inp.max_length): sys_exit(1)
    if m3_input_validate_len_1009(1000, inp.max_length): sys_exit(1)

fn main():
