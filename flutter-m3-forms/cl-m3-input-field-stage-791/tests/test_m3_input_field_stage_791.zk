import "../m3i_791.zk"

fn test_run():
    let inp = create_m3_input_791("Enter username")
    if inp.max_length != 41: sys_exit(1)
    if not m3_input_validate_len_791(10, inp.max_length): sys_exit(1)
    if m3_input_validate_len_791(1000, inp.max_length): sys_exit(1)

fn main():
