import "../m3i_4192.zk"

fn test_run():
    let inp = create_m3_input_4192("Enter username")
    if inp.max_length != 42: sys_exit(1)
    if not m3_input_validate_len_4192(10, inp.max_length): sys_exit(1)
    if m3_input_validate_len_4192(1000, inp.max_length): sys_exit(1)

fn main():
