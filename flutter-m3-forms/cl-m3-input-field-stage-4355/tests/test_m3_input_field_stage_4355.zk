import "../m3i_4355.zk"

fn test_run():
    let inp = create_m3_input_4355("Enter username")
    if inp.max_length != 45: sys_exit(1)
    if not m3_input_validate_len_4355(10, inp.max_length): sys_exit(1)
    if m3_input_validate_len_4355(1000, inp.max_length): sys_exit(1)

fn main():
