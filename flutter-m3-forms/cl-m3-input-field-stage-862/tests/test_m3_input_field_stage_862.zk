// cl-m3-input-field-stage-862: Test Suite
import "../m3i_862.zk"

fn test_run():
    let inp = create_m3_input_862("Enter username")
    if inp.max_length != 32: sys_exit(1)
    if not m3_input_validate_len_862(10, inp.max_length): sys_exit(1)
    if m3_input_validate_len_862(1000, inp.max_length): sys_exit(1)

fn main():
    test_run()
    print("✓ All tests passed for cl-m3-input-field-stage-862!")
