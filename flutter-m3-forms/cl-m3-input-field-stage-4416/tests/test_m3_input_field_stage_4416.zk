import "../m3i_4416.zk"

fn test_run():
    let inp = create_m3_input_4416("Enter username")
    if inp.max_length != 46: sys_exit(1)
    if not m3_input_validate_len_4416(10, inp.max_length): sys_exit(1)
    if m3_input_validate_len_4416(1000, inp.max_length): sys_exit(1)

fn main():
