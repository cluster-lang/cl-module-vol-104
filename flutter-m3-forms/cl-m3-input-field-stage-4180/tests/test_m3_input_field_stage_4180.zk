import "../m3i_4180.zk"

fn test_run():
    let inp = create_m3_input_4180("Enter username")
    if inp.max_length != 30: sys_exit(1)
    if not m3_input_validate_len_4180(10, inp.max_length): sys_exit(1)
    if m3_input_validate_len_4180(1000, inp.max_length): sys_exit(1)

fn main():
