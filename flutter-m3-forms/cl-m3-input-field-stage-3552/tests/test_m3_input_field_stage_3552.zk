import "../m3i_3552.zk"

fn test_run():
    let inp = create_m3_input_3552("Enter username")
    if inp.max_length != 42: sys_exit(1)
    if not m3_input_validate_len_3552(10, inp.max_length): sys_exit(1)
    if m3_input_validate_len_3552(1000, inp.max_length): sys_exit(1)

fn main():
