// cl-m3-input-field-stage-2128: Test Suite
import "../m3i_2128.zk"

fn test_run():
    let inp = create_m3_input_2128("Enter username")
    if inp.max_length != 38: sys_exit(1)
    if not m3_input_validate_len_2128(10, inp.max_length): sys_exit(1)
    if m3_input_validate_len_2128(1000, inp.max_length): sys_exit(1)

fn main():
    test_run()
    print("✓ All tests passed for cl-m3-input-field-stage-2128!")
