// cl-m3-input-field-stage-215: Test Suite
import "../m3i_215.zk"

fn test_run():
    let inp = create_m3_input_215("Enter username")
    if inp.max_length != 45: sys_exit(1)
    if not m3_input_validate_len_215(10, inp.max_length): sys_exit(1)
    if m3_input_validate_len_215(1000, inp.max_length): sys_exit(1)

fn main():
    test_run()
    print("✓ All tests passed for cl-m3-input-field-stage-215!")
