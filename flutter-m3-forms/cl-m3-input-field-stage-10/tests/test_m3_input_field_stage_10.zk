// cl-m3-input-field-stage-10: Test Suite
import "../m3i_10.zk"

fn test_run():
    let inp = create_m3_input_10("Enter username")
    if inp.max_length != 40: sys_exit(1)
    if not m3_input_validate_len_10(10, inp.max_length): sys_exit(1)
    if m3_input_validate_len_10(1000, inp.max_length): sys_exit(1)

fn main():
    test_run()
    print("✓ All tests passed for cl-m3-input-field-stage-10!")
