import "../m3i_4442.zk"

fn test_run():
    let inp = create_m3_input_4442("Enter username")
    if inp.max_length != 32: sys_exit(1)
    if not m3_input_validate_len_4442(10, inp.max_length): sys_exit(1)
    if m3_input_validate_len_4442(1000, inp.max_length): sys_exit(1)

fn main():
    test_run()
    print("✓ All tests passed for cl-m3-input-field-stage-4442!")
