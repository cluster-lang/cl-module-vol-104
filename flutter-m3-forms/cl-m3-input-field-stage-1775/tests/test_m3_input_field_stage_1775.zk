import "../m3i_1775.zk"

fn test_run():
    let inp = create_m3_input_1775("Enter username")
    if inp.max_length != 45: sys_exit(1)
    if not m3_input_validate_len_1775(10, inp.max_length): sys_exit(1)
    if m3_input_validate_len_1775(1000, inp.max_length): sys_exit(1)

fn main():
