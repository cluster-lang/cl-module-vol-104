// cl-m3-input-field-stage-234: Test Suite
import "../m3i_234.zk"

fn test_run():
    let inp = create_m3_input_234("Enter username")
    if inp.max_length != 44: sys_exit(1)
    if not m3_input_validate_len_234(10, inp.max_length): sys_exit(1)
    if m3_input_validate_len_234(1000, inp.max_length): sys_exit(1)

fn main():
    test_run()
    print("✓ All tests passed for cl-m3-input-field-stage-234!")
