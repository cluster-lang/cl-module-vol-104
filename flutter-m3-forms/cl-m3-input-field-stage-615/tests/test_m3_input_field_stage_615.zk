// cl-m3-input-field-stage-615: Test Suite
import "../m3i_615.zk"

fn test_run():
    let inp = create_m3_input_615("Enter username")
    if inp.max_length != 45: sys_exit(1)
    if not m3_input_validate_len_615(10, inp.max_length): sys_exit(1)
    if m3_input_validate_len_615(1000, inp.max_length): sys_exit(1)

fn main():
    test_run()
    print("✓ All tests passed for cl-m3-input-field-stage-615!")
