// cl-m3-input-field-stage-3270: Test Suite
import "../m3i_3270.zk"

fn test_run():
    let inp = create_m3_input_3270("Enter username")
    if inp.max_length != 40: sys_exit(1)
    if not m3_input_validate_len_3270(10, inp.max_length): sys_exit(1)
    if m3_input_validate_len_3270(1000, inp.max_length): sys_exit(1)

fn main():
    test_run()
    print("✓ All tests passed for cl-m3-input-field-stage-3270!")
