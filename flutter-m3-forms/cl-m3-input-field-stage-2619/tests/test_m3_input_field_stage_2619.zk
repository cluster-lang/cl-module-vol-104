import "../m3i_2619.zk"

fn test_run():
    let inp = create_m3_input_2619("Enter username")
    if inp.max_length != 49: sys_exit(1)
    if not m3_input_validate_len_2619(10, inp.max_length): sys_exit(1)
    if m3_input_validate_len_2619(1000, inp.max_length): sys_exit(1)

fn main():
