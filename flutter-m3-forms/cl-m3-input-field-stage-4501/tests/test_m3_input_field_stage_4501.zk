// cl-m3-input-field-stage-4501: Test Suite
import "../m3i_4501.zk"

fn test_run():
    let inp = create_m3_input_4501("Enter username")
    if inp.max_length != 31: sys_exit(1)
    if not m3_input_validate_len_4501(10, inp.max_length): sys_exit(1)
    if m3_input_validate_len_4501(1000, inp.max_length): sys_exit(1)

fn main():
    test_run()
    print("✓ All tests passed for cl-m3-input-field-stage-4501!")
