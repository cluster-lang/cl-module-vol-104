import "../m3i_4077.zk"

fn test_run():
    let inp = create_m3_input_4077("Enter username")
    if inp.max_length != 47: sys_exit(1)
    if not m3_input_validate_len_4077(10, inp.max_length): sys_exit(1)
    if m3_input_validate_len_4077(1000, inp.max_length): sys_exit(1)

fn main():
