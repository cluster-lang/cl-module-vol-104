import "../m3i_2335.zk"

fn test_run():
    let inp = create_m3_input_2335("Enter username")
    if inp.max_length != 45: sys_exit(1)
    if not m3_input_validate_len_2335(10, inp.max_length): sys_exit(1)
    if m3_input_validate_len_2335(1000, inp.max_length): sys_exit(1)

fn main():
