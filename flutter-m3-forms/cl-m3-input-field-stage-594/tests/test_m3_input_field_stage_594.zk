import "../m3i_594.zk"

fn test_run():
    let inp = create_m3_input_594("Enter username")
    if inp.max_length != 44: sys_exit(1)
    if not m3_input_validate_len_594(10, inp.max_length): sys_exit(1)
    if m3_input_validate_len_594(1000, inp.max_length): sys_exit(1)

fn main():
